FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y build-essential git curl && rm -rf /var/lib/apt/lists/*

# Install uv via installer script (avoids ghcr rate limits)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && cp /root/.local/bin/uv /usr/local/bin/uv

COPY . /app
RUN uv pip install --system -e ".[proxy]"

ENV PYTHONPATH=/app/src
EXPOSE 4001
CMD ["uvicorn", "scillm.proxy.app:app", "--host", "0.0.0.0", "--port", "4001"]
