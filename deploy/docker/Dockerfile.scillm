# Single-stage Python scillm image (no Bifrost)
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y build-essential git curl && rm -rf /var/lib/apt/lists/*

# Install Node.js and headless model/agent CLIs.
# /v1/scillm/exec can call Gemini, Codex, or Claude CLIs when the matching
# runner is selected. Command templates remain configurable through
# SCILLM_CODEX_EXEC_TEMPLATE and SCILLM_CLAUDE_PRINT_TEMPLATE.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g @google/gemini-cli @openai/codex @anthropic-ai/claude-code \
    && rm -rf /var/lib/apt/lists/*

# Install latest OpenCode binary for live model discovery.
RUN curl -fsSL https://opencode.ai/install | bash \
    && cp /root/.opencode/bin/opencode /usr/local/bin/opencode

# Install uv via installer script
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && cp /root/.local/bin/uv /usr/local/bin/uv

# Copy scillm source and install
COPY . /app
RUN uv pip install --system -e ".[proxy]"

COPY deploy/docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV PYTHONPATH=/app/src
EXPOSE 4001
CMD ["/app/entrypoint.sh"]