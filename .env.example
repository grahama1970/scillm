# scillm proxy environment
# Copy to .env and fill in your API keys.

# ── Proxy auth ────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=replace-with-a-local-secret
SCILLM_MASTER_KEY=replace-with-a-local-secret

# ── Primary provider (Chutes) ────────────────────────────────────────
# Required for the default 'text' and 'vlm' model groups.
CHUTES_API_KEY=
CHUTES_API_BASE=https://llm.chutes.ai/v1

# ── Fallback providers (optional) ────────────────────────────────────
# Each enables an additional fallback in the cascade.

# GPT image generation (POST /v1/images/generations, models gpt-image-*)
# Codex OAuth does not include the Images API scope.
# OPENAI_API_KEY=sk-...
DEEPSEEK_API=                    # text-deepseek group
GEMINI_API_KEY=                  # text-gemini group
OPENROUTER_API_KEY=              # vlm-openrouter group
MOONSHOT_API_KEY=                # moonshot-text group
OPENCODE_GO_API_KEY=             # opencode-go/<model-id> auto-routing
# OPENCODE_GO_API_BASE=https://opencode.ai/zen/go/v1

# /v1/scillm/opencode-go/models uses the Docker-installed
# `opencode models --refresh opencode-go` CLI by default. The Docker compose
# mounts ~/.local/share/opencode/auth.json, ~/.config/opencode, and
# ~/.cache/opencode so the container sees the same connected providers as host.
# These optional settings enable fallback discovery from `opencode serve`.
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# ── Redis (optional — enables caching + request logging) ─────────────
# Included in docker-compose.yml. Set these if running Redis separately.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ── Ollama (optional — for local-text model group) ───────────────────
# Included via: docker compose --profile local up -d
# OLLAMA_API_BASE=http://127.0.0.1:11434

# OpenCode serve (Tier-2 session workers via /v1/scillm/opencode/*)
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
SCILLM_OPENCODE_DEBUGGER_AGENT=scillm-debugger
SCILLM_OPENCODE_SERVE_OUTPUT_DIR=
SCILLM_OPENCODE_SKILL_VIEW_DIR=/tmp/scillm-opencode-skill-views
# Colon-separated skill roots for per-run .opencode/skills symlinks
SCILLM_OPENCODE_SKILL_ROOTS=/home/graham/.claude/skills:/home/graham/.codex/skills

# Kimi CLI exec (kimi_exec runner; mount ~/.kimi into proxy for Docker)
SCILLM_KIMI_EXEC_MODEL=kimi-for-coding

# Live kimi_exec gate compares exec output to Moonshot API kimi-k2.6
SCILLM_SKIP_MOONSHOT_VERIFY=0
