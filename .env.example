# ======================================
# LiteLLM Project Environment (.env.example)
# Copy to .env and adjust as needed.
# API keys are expected in ~/.secrets/llm.env
# ======================================

# -- LiteLLM defaults --
LITELLM_DEFAULT_CODE_MODEL=ollama/qwen2.5-coder:14b
LITELLM_DEFAULT_MODEL=ollama/glm4:latest
LITELLM_DEFAULT_VISION_MODEL=ollama/gemma3:latest
LITELLM_DEFAULT_LARGE_MODEL=gemini/gemini-2.5-flash
LITELLM_DEFAULT_CHUTES_MODEL=deepseek-ai/DeepSeek-R1

# -- Moonshot defaults --
MOONSHOT_MODEL=kimi-k2-turbo-preview

# -- Chutes model defaults --
# Canonical text model env is CHUTES_MODEL_ID; CHUTES_TEXT_MODEL remains as legacy alias.
CHUTES_MODEL_ID=
CHUTES_TEXT_MODEL=
CHUTES_TEXT_MODEL_ALT1=
CHUTES_TEXT_MODEL_ALT2=
CHUTES_TOOLS_MODEL=
CHUTES_VLM_MODEL=
CHUTES_VLM_MODEL_ALT1=
CHUTES_VLM_MODEL_ALT2=

# -- Chutes API base (non-secret) --
# Either include '/v1' or not; code auto-detects the correct form per tenant.
CHUTES_API_BASE=
CHUTES_AUTH_STYLE=bearer

# -- Code agent model --
CODE_AGENT_MODEL=

# -- Mini agent settings --
DOCKER_MINI_AGENT=
MINI_AGENT_API_HOST=
MINI_AGENT_API_PORT=
MINI_AGENT_URL=

# -- Release pipeline settings --
RELEASE_IMAGE_PATH=
RELEASE_PARALLEL_API_BASE=
RELEASE_PARALLEL_MODEL=

# -- Other project vars --
OLLAMA_DATA_DIR=
CERTAINLY_MODEL=
DEEPSEEK_API=

# -- Secrets (placeholders; keep in ~/.secrets/llm.env) --
# OPENAI_API_KEY=sk-...
# MOONSHOT_API_KEY=sk-...
# PERPLEXITY_API_KEY=pplx-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENROUTER_API_KEY=...
# CONTEXT7_API_KEY=...
# BRAVE_API_KEY=...
# CHUTES_API_KEY=...
# RELEASE_PARALLEL_API_KEY=...
