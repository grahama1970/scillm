# scillm proxy environment
# Copy to .env and fill in your API keys.

# ── Proxy auth ────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-dev-proxy-123

# ── Primary provider (Chutes) ────────────────────────────────────────
# Required for the default 'text' and 'vlm' model groups.
CHUTES_API_KEY=
CHUTES_API_BASE=https://llm.chutes.ai/v1

# ── Fallback providers (optional) ────────────────────────────────────
# Each enables an additional fallback in the cascade.
DEEPSEEK_API=                    # text-deepseek group
GEMINI_API_KEY=                  # text-gemini group
OPENROUTER_API_KEY=              # vlm-openrouter group
MOONSHOT_API_KEY=                # moonshot-text group

# ── Redis (optional — enables caching + request logging) ─────────────
# Included in docker-compose.yml. Set these if running Redis separately.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ── Ollama (optional — for local-text model group) ───────────────────
# Included via: docker compose --profile local up -d
# OLLAMA_API_BASE=http://127.0.0.1:11434
