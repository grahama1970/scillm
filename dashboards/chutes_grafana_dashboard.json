{
  "title": "Chutes Budget & 429s",
  "panels": [
    {
      "type": "stat",
      "title": "Remaining Calls",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "chutes_budget_remaining{env=~\"$env\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Daily Limit",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "chutes_budget_limit{env=~\"$env\"}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Time To Reset (min)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "(chutes_reset_timestamp_seconds{env=~\"$env\"} - time()) / 60"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "429s by Kind (rate)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "(sum by (kind) (rate(chutes_429_total{env=~\"$env\"}[$window]))) or vector(0)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Calls OK (rate)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(chutes_calls_total{result=\"ok\",env=~\"$env\"}[$window]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tenacious Sleep Seconds (rate)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "rate(sc_tenacious_sleep_seconds_total{env=~\"$env\"}[$window])"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "filters",
        "type": "adhoc",
        "datasource": "${DS_PROMETHEUS}"
      },
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "hide": 0,
        "current": {
          "text": "SCILLM_PROM",
          "value": "SCILLM_PROM"
        }
      },
      {
        "name": "env",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(chutes_calls_total, env)",
        "includeAll": true,
        "refresh": 1
      },
      {
        "name": "window",
        "type": "custom",
        "query": "5m,15m,1h",
        "current": {
          "text": "5m",
          "value": "5m"
        }
      }
    ]
  },
  "schemaVersion": 39,
  "version": 2
}