{
  "id": null,
  "uid": "sclm-budget-lite",
  "title": "SciLLM Budget Lite (Chutes)",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "style": "dark",
  "tags": [
    "scillm",
    "budget",
    "chutes"
  ],
  "templating": {
    "list": [
      {
        "name": "filters",
        "type": "adhoc",
        "datasource": {
          "type": "prometheus",
          "uid": "$DS_PROMETHEUS"
        }
      },
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {
          "text": "SCILLM_PROM",
          "value": "SCILLM_PROM"
        }
      },
      {
        "name": "env",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(sc_calls_total, env)",
        "includeAll": true,
        "refresh": 1
      },
      {
        "name": "window",
        "type": "custom",
        "query": "5m,15m,1h"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests OK (5m)",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "expr": "sum(increase(sc_calls_total{result=\"ok\", env=~\"$env\"}[$window]))",
          "legendFormat": "ok"
        }
      ]
    },
    {
      "type": "stat",
      "title": "429s (5m)",
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "expr": "sum(increase(sc_calls_total{result=\"429\", env=~\"$env\"}[$window]))",
          "legendFormat": "429"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Budget Remaining",
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "expr": "sum(sc_budget_remaining{env=~\"$env\"})",
          "legendFormat": "remaining"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Remaining (24h)",
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "sum(sc_budget_remaining{env=~\"$env\"})",
          "legendFormat": "remaining"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "QPS (ok, 429)",
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(sc_calls_total{env=~\"$env\"}[$window]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ]
}