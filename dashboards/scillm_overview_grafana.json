{
  "title": "SciLLM Overview",
  "schemaVersion": 38,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "filters",
        "type": "adhoc",
        "datasource": "${DS_PROMETHEUS}"
      },
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "hide": 0,
        "current": {
          "text": "SCILLM_PROM",
          "value": "SCILLM_PROM"
        }
      },
      {
        "name": "env",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(sc_calls_total, env)",
        "includeAll": true,
        "refresh": 1
      },
      {
        "name": "window",
        "type": "custom",
        "query": "5m,15m,1h",
        "current": {
          "text": "15m",
          "value": "15m"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests OK (QPS)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (env) (rate(sc_calls_total{result=\"ok\", env=~\"$env\"}[$window]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Cost by Provider/Model (USD, 24h)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (vendor,model) (increase(sc_cost_usd_total{env=~\"$env\"}[24h]))",
          "legendFormat": "{{vendor}} \u00b7 {{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Daily Cost (USD, 24h)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(increase(sc_cost_usd_total{env=~\"$env\"}[24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Error Rate (%)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "100 * (sum(rate(sc_calls_total{result=~\"error|5xx|timeout|cancel\", env=~\"$env\"}[$window])) / clamp_min(sum(rate(sc_calls_total{env=~\"$env\"}[$window])), 1e-9))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "P95 Latency (ms)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sc_request_seconds_bucket{env=~\"$env\"}[$window]))) * 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "orange",
                "value": 2000
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "In-Flight Requests",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(sc_calls_in_flight{env=~\"$env\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Router & Streaming"
    },
    {
      "type": "timeseries",
      "title": "Router Failovers by Reason (rate)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (reason) (rate(sc_router_failover_total{env=~\"$env\"}[$window])) or vector(0)",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "First Byte P95 (ms)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(sc_stream_first_byte_seconds_bucket{env=~\"$env\"}[$window])) ) * 1000) or vector(0)"
        }
      ]
    },
    {
      "type": "row",
      "title": "Budgets / Capacity"
    },
    {
      "type": "stat",
      "title": "Remaining Calls",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(sc_budget_remaining{env=~\"$env\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Daily Limit",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(sc_budget_limit{env=~\"$env\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Time To Reset (min)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "(max(sc_reset_timestamp_seconds{env=~\"$env\"}) - time()) / 60"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "429s (rate)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (env) (rate(sc_calls_total{result=\"429\", env=~\"$env\"}[$window])) or vector(0)",
          "legendFormat": "core 429"
        },
        {
          "expr": "sum by (kind) (rate(chutes_429_total{env=~\"$env\"}[$window]))",
          "legendFormat": "chutes {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Retries by Reason (rate)",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum by (reason) (rate(sc_retries_total{env=~\"$env\"}[$window])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 0
        },
        "overrides": []
      }
    }
  ]
}